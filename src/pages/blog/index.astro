---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead
			title={'所有文章'}
			description={`整理《${SITE_TITLE}》Podcast 對談文章，從男性困境、情感腳本到多元對話，讀懂台灣性別議題。`}
			pageKind="collection"
			jsonLdExtra={{
				mainEntity: {
					'@type': 'ItemList',
					itemListElement: posts.map((post, index) => ({
						'@type': 'ListItem',
						position: index + 1,
						url: new URL(`/blog/${post.id}/`, Astro.site).toString(),
						name: post.data.title,
					})),
				},
			}}
		/>
		<style>
			main {
				width: min(var(--content-width), calc(100% - 2.5rem));
				max-width: none;
			}
			.intro {
				margin-bottom: 2.5rem;
			}
			.eyebrow {
				display: inline-block;
				margin: 0 0 1rem;
				color: var(--accent-dark);
				font-size: 0.82rem;
				font-weight: 600;
			}
			.intro p {
				max-width: 620px;
				color: var(--text-secondary);
			}
			.posts {
				margin-top: 1.5rem;
			}
			.list-toolbar {
				display: flex;
				align-items: center;
				justify-content: flex-end;
				gap: 0.6rem;
				padding-bottom: 0.9rem;
				border-bottom: 1px solid var(--border);
			}
			.list-toolbar label {
				font-size: 0.85rem;
				color: var(--text-muted);
			}
			.list-toolbar select {
				padding: 0.4rem 0.6rem;
				border: 1px solid var(--border);
				border-radius: 0.5rem;
				background: var(--surface-soft);
				color: var(--text-primary);
				font-family: inherit;
				font-size: 0.85rem;
				cursor: pointer;
			}
			.list-toolbar select:hover {
				border-color: var(--accent);
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="transition-swup-fade onload-animation">
			<section class="intro">
				<p class="eyebrow">文章總覽</p>
				<h1>所有文章</h1>
				<p>把 Podcast 裡那些還沒聊完的性別問題，整理成可以慢慢讀、慢慢想的文字。</p>
			</section>
			<div class="list-toolbar">
				<label for="sort-order">排序</label>
				<select id="sort-order" data-sort-order>
					<option value="newest">最新文章</option>
					<option value="oldest">最舊文章</option>
					<option value="episode-newest">最新集數</option>
					<option value="episode-oldest">最舊集數</option>
				</select>
			</div>
			<section class="posts" aria-label="文章列表" data-post-list>
				{posts.map((post) => <ArticleCard post={post} />)}
			</section>
		</main>
		<Footer />
	</body>
</html>
