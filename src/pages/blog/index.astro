---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead
			title={`所有文章 — ${SITE_TITLE}`}
			description={`整理《${SITE_TITLE}》Podcast 對談文章，從男性困境、情感腳本到多元對話，讀懂台灣性別議題。`}
			pageKind="collection"
			jsonLdExtra={{
				mainEntity: {
					'@type': 'ItemList',
					itemListElement: posts.map((post, index) => ({
						'@type': 'ListItem',
						position: index + 1,
						url: new URL(`/blog/${post.id}/`, Astro.site).toString(),
						name: post.data.title,
					})),
				},
			}}
		/>
		<style>
			main {
				width: min(var(--content-width), calc(100% - 2.5rem));
				max-width: none;
			}
			.intro {
				margin-bottom: 2.5rem;
			}
			.eyebrow {
				display: inline-block;
				margin: 0 0 1rem;
				color: var(--accent-dark);
				font-size: 0.82rem;
				font-weight: 600;
			}
			.intro p {
				max-width: 620px;
				color: var(--text-secondary);
			}
			.posts {
				margin-top: 1.5rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="transition-swup-fade onload-animation">
			<section class="intro">
				<p class="eyebrow">文章總覽</p>
				<h1>所有文章</h1>
				<p>把 Podcast 裡那些還沒聊完的性別問題，整理成可以慢慢讀、慢慢想的文字。</p>
			</section>
			<section class="posts" aria-label="文章列表">
				{posts.map((post) => <ArticleCard post={post} />)}
			</section>
		</main>
		<Footer />
	</body>
</html>
