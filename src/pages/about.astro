---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LISTEN_PLATFORMS } from '../data/listen-platforms';

// 頁面文字由 /admin 的「關於節目」單頁維護，見 src/content/pages/about.md。
const about = await getEntry('pages', 'about');
if (!about) throw new Error('缺少 src/content/pages/about.md，關於節目頁無法產生。');
const { Content } = await render(about);
const { title, subtitle, description, missionTitle, statsTitle, statsNote, stats, listenTitle, listenIntro } = about.data;
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead title={'關於節目'} description={description} pageKind="about" />
		<style>
			main {
				width: min(var(--content-width), calc(100% - 2.5rem));
				max-width: none;
			}
			.about-hero {
				padding-block: 1rem 2.5rem;
				text-align: center;
			}
			.about-hero h1 {
				margin: 0 0 0.9rem;
				font-size: clamp(1.9rem, 5vw, 2.6rem);
			}
			.about-hero .subtitle {
				margin: 0;
				color: var(--text-secondary);
				font-size: clamp(1rem, 2.4vw, 1.15rem);
			}
			.rule {
				margin: 0;
				border: 0;
				border-top: 1px solid var(--border);
			}
			.about-section {
				padding-block: 2.75rem;
			}
			.about-section h2 {
				margin: 0 0 1.5rem;
				padding: 0;
				border: 0;
				font-size: 1.45rem;
				color: var(--heading-secondary);
			}
			.mission :global(p) {
				margin: 0 0 1.15rem;
				line-height: 1.9;
			}
			.mission :global(ol) {
				margin: 0 0 1.15rem;
				padding-left: 1.35rem;
				display: grid;
				gap: 0.65rem;
			}
			.mission :global(li) {
				line-height: 1.85;
			}
			.mission :global(p:last-child) {
				margin-bottom: 0;
			}
			.stats-note {
				margin-left: 0.6rem;
				font-size: 0.8rem;
				font-weight: 400;
				color: var(--text-muted);
			}
			.stats {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 1.25rem;
			}
			.stat {
				text-align: center;
			}
			.stat .num {
				font-size: clamp(1.35rem, 3.4vw, 1.7rem);
				font-weight: 700;
				color: var(--accent);
				line-height: 1.2;
			}
			.stat .label {
				margin-top: 0.35rem;
				font-size: 0.8rem;
				color: var(--text-muted);
			}
			.listen-intro {
				margin: 0 0 1.25rem;
				color: var(--text-secondary);
			}
			.listen-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
				gap: 0.7rem;
			}
			.listen-grid a {
				display: flex;
				align-items: center;
				gap: 0.8rem;
				padding: 0.7rem 0.9rem;
				border: 1px solid var(--border);
				border-radius: 0.7rem;
				color: var(--text-primary);
				text-decoration: none;
				transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
			}
			.listen-grid a:hover {
				border-color: var(--accent);
				background: var(--surface-raised);
				transform: translateY(-1px);
			}
			.platform-icon {
				display: inline-flex;
				width: 1.9rem;
				height: 1.9rem;
				flex: none;
				align-items: center;
				justify-content: center;
			}
			.platform-icon :global(svg) {
				width: 100%;
				height: 100%;
			}
			.platform-icon :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0.4rem;
			}
			.platform-name {
				flex: 1;
				font-weight: 700;
				font-size: 0.95rem;
			}
			.platform-go {
				color: var(--text-muted);
			}
			@media (max-width: 640px) {
				.stats {
					grid-template-columns: repeat(2, minmax(0, 1fr));
					gap: 1.4rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content" class="transition-swup-fade onload-animation">
			<section class="about-hero">
				<h1>{title}</h1>
				{subtitle && <p class="subtitle">{subtitle}</p>}
			</section>

			<hr class="rule" />

			<section class="about-section mission" aria-labelledby="mission-heading">
				<h2 id="mission-heading">{missionTitle}</h2>
				<Content />
			</section>

			{stats.length > 0 && (
				<>
					<hr class="rule" />
					<section class="about-section" aria-labelledby="stats-heading">
						<h2 id="stats-heading">
							{statsTitle}
							{statsNote && <span class="stats-note">{statsNote}</span>}
						</h2>
						<div class="stats">
							{stats.map((s) => (
								<div class="stat">
									<div class="num">{s.num}</div>
									<div class="label">{s.label}</div>
								</div>
							))}
						</div>
					</section>
				</>
			)}

			<hr class="rule" />

			<section class="about-section" aria-labelledby="listen-heading">
				<h2 id="listen-heading">{listenTitle}</h2>
				{listenIntro && <p class="listen-intro">{listenIntro}</p>}
				<div class="listen-grid">
					{LISTEN_PLATFORMS.map((p) => (
						<a href={p.url} target="_blank" rel="noopener noreferrer" class="scale-animation">
							<span class="platform-icon" style={p.color ? `color:${p.color}` : undefined}>
								{p.icon ? <Fragment set:html={p.icon} /> : <Image src={p.img!} width={72} height={72} alt="" />}
							</span>
							<span class="platform-name">{p.name}</span>
							<span class="platform-go" aria-hidden="true">↗</span>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
