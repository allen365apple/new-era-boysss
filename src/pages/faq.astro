// 這裡不放任何節目沒有討論過的推測，也不代替主持人給新的立場。
interface Faq {
	q: string;
	/** 正統定義：概念出處與學界／法律上的說法。 */
	def?: string;
	/** 節目裡的說法。與 def 合併後供 FAQPage 結構化資料使用。 */
	a: string;
	source: { label: string; href: string };
}

