---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { FAQ_REVIEW_DATE } from '../data/faq-meta.mjs';

// 概念／法律說明依外部資料整理；節目討論另列單集，不將兩者混為同一來源。
interface Faq {
	q: string;
	/** 概念資料的白話整理，與節目討論分開標示。 */
	def?: string;
	definitionLabel?: string;
	references?: { label: string; href: string }[];
	/** 節目裡的說法。與 def 合併後供 FAQPage 結構化資料使用。 */
	a: string;
	source: { label: string; href: string };
}

const FAQS: Faq[] = [
	{
		q: '女權為什麼不叫「平權」就好？',
		a: '節目把這個問題拉回歷史來看。從投票權到工作權，這條路是女性前人一步步鋪出來的，保留這個名稱是對那段歷史的標記，也是一個現實提醒：在父權結構還沒鬆動的今天，女性仍是相對弱勢的一方。名稱要對抗的是體制，不是男性個人。',
		source: { label: 'EP48 性別大辯論（上）', href: '/blog/ep48/' },
	},
	{
		q: '「厭男」是討厭所有男人嗎？',
		def: "misandry 對應的是對男性的憎惡，這是字典中的一般詞義。下方來賓談到的防衛、受傷與權力差異，是本集的討論脈絡，不能直接當成所有場合共用的定義。",
		references: [{"label": "Merriam-Webster：misandry 詞義", "href": "https://www.merriam-webster.com/dictionary/misandry"}],
		a: '不是。本集來賓談的是更具體的一群人：在父權結構裡享有某些方便，卻完全不覺得自己曾得到什麼，甚至反過來嘲諷提出性別不平等的人。節目也把厭男形容成一副鎧甲，它可能誤傷沒有惡意的人；但如果只要求女性立刻卸下防備，卻不處理她為什麼需要穿上它，對話就回不到真正的問題。',
		source: { label: 'EP5 厭男到底在厭什麼？', href: '/blog/ep5/' },
	},
	{
		q: '約會第一次該男生買單嗎？',
		a: '節目沒有給標準答案。來賓莉庭並不反對所有由一方付錢的關係，她在意的是兩個人有沒有談過、而且是否都舒服。情侶若已經形成彼此接受的分工，那是他們的共識；但把陌生規則直接套在每一場約會上，請客就可能從好意變成壓力。',
		source: { label: 'EP2 約會該男生買單嗎？', href: '/blog/ep2/' },
	},
	{
		q: '男生走在外側真的比較體貼嗎？',
		a: '路況真的危險時彼此提醒當然有用。問題在於，當它變成男生的必做題，女生也就被預設成需要被保護的那一方。主持人也坦承，自己做這個動作時不完全是在評估危險，有時更像在心裡演一齣戲：她會不會注意到、會不會覺得這個男生很貼心。',
		source: { label: 'EP2 拆解直男體貼背後的性別腳本', href: '/blog/ep2/' },
	},
	{
		q: '什麼是「有毒的陽剛氣質」？',
		def: "toxic masculinity 常用來批評把強硬、支配、不能示弱等要求當成男性唯一標準的規範。APA 討論的是某些僵化規範可能帶來的傷害，而不是把所有男性或所有陽剛特質視為有問題。",
		references: [{"label": "APA：有害陽剛規範與暴力", "href": "https://www.apa.org/topics/men-boys/harmful-masculinity"}],
		a: '這個詞聽起來像在罵男人，其實是說社會替男性訂了一套很窄的成功條件：要強壯、要主動、要有人愛、不能示弱。於是沒達標的人自我懷疑，達標的人也不敢停下來。它指的是那套條件，不是指男性本身有毒。',
		source: { label: 'EP4 男性自我價值感從哪來？', href: '/blog/ep4/' },
	},
	{
		q: '什麼是 mansplaining（男性說教）？',
		def: "Merriam-Webster 將 mansplain 解釋為男性向女性解說時，採取居高臨下的態度，並預設對方不懂。重點是這種預設與互動方式，不是男性只要解釋事情就算男性說教。",
		references: [{"label": "Merriam-Webster：mansplain 詞義", "href": "https://www.merriam-webster.com/dictionary/mansplain"}],
		a: '指的是預設對方不懂，居高臨下地解釋一遍。節目裡有個很具體的例子：主持人柏文曾拿網路論戰考伴侶「看得出這個人的論述哪裡有問題嗎」，後來才意識到自己渴望被崇拜，卻把對方放在被測驗、被指導的位置。討論到這一步，對方不只要處理議題，還得額外照顧提問者的情緒。',
		source: { label: 'EP8 身體界線怎麼學？', href: '/blog/ep8/' },
	},
	{
		q: '男生可以談女性主義嗎？會不會被說虛偽？',
		a: '受訪的方念萱老師沒有給「可以」或「不行」的答案。她舉了兩個學生的例子，一個為了設計求婚儀式焦頭爛額，一個為了同事疑似被性騷擾而著急；她看到的不是男生做得對不對，而是他們開始在意、開始彷徨了。重點是別急著拿理論、拿別人的答案，當成自己的答案。',
		source: { label: 'EP1 直男為什麼總覺得委屈？', href: '/blog/ep1/' },
	},
	{
		q: '男性也有性別困境嗎？',
		a: '有。父權體制不只給男性方便，也同時規定男性該長成什麼樣子：要剛強、壓抑情感、隨時準備被丟去打仗或當成資本的燃料。另一集從《男孩危機》談到，一個男孩常是先學會賺錢、保護別人，才學會照顧自己的情緒。',
		source: { label: 'EP49 性別大辯論（下）', href: '/blog/ep49/' },
	},
	{
		q: '「現在男生做什麼都被說性騷擾」是真的嗎？',
		def: "不能只憑性別或一句話就判定是否構成性騷擾。台灣《性騷擾防治法》要求檢查違反意願、與性或性別相關的行為及法定影響；施行細則也要求綜合背景、環境、雙方關係與具體言行。職場、校園等情境還可能適用不同法律。",
		definitionLabel: '法律說明',
		references: [{"label": "全國法規資料庫：《性騷擾防治法》第1、2條", "href": "https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=D0050074"}, {"label": "全國法規資料庫：《性騷擾防治法施行細則》第2條", "href": "https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=D0050135"}],
		a: "這集談的是一種常見恐慌：有些男生覺得自己怎麼做都會被指責。節目也對照性醜聞後果的性別落差：同樣捲入，男性常被說成風流，女性卻面臨長期的蕩婦羞辱。這段討論不能拿來判定個別事件是否違法，仍要回到具體事實與適用法律。",
		source: { label: 'EP49 性別大辯論（下）', href: '/blog/ep49/' },
	},
	{
		q: '對方沒有回應，我還繼續靠近，算騷擾嗎？',
		def: "台灣《跟蹤騷擾防制法》第3條第1項要求：有反覆或持續、違反意願且與性或性別相關的列舉行為，並造成足以影響生活或社會活動的畏懼。第2項對波及特定人親友的情況另有規定，可能不以性或性別相關為必要。只有「沒有回應」這項資訊，不足以判定是否成立。",
		definitionLabel: '法律說明',
		references: [{"label": "全國法規資料庫：《跟蹤騷擾防制法》第3條", "href": "https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=D0080211"}],
		a: "這集從持續越界的追求經驗談界線：表達喜歡不代表可以忽略對方的意願。節目提醒，不能把沒有回應當成繼續靠近的邀請。這是關係互動上的提醒；是否構成法律上的跟蹤騷擾，仍須依上方要件與個案事實判斷。",
		source: { label: 'EP64 一個「女生」是如何被養成的？', href: '/blog/ep64/' },
	},
	{
		q: '男生哭很奇怪嗎？',
		a: '「男生可以哭」聽起來已經不新鮮，但主持人柏文是在有了獨處空間後，才第一次有意識地讓自己哭完。過去不是沒有悲傷，而是家裡、宿舍與「哭很丟臉」的規矩，讓他習慣在身體發出訊號時把情緒壓回去。這件事需要練習：先辨認胸口卡住、眼淚要來的感覺，再找一個能安心釋放的地方。',
		source: { label: 'EP8 身體界線怎麼學？', href: '/blog/ep8/' },
	},
	{
		q: '交友軟體一直配對不到，是我不夠好嗎？',
		a: '節目提醒，平台有自己的男女比例、配對機制和注意力分配，不能把它當成真實世界的縮小版。少數配對，不等於一個人的吸引力只有那麼少。照片和自介可以整理，讓別人更容易認識你，但那最多是增加被看見的機會，不能保證對方喜歡你。',
		source: { label: 'EP7 交友軟體為何讓直男焦慮？', href: '/blog/ep7/' },
	},
];

// 名詞的概念來源與相關單集分開；不把本站補充說明當作來賓原話。
const TERMS: Faq[] = [
	{
		q: '什麼是女性主義？',
		def: "依 UN Women 的介紹，女性主義關心女性在社會、政治、法律與經濟上能否享有平等權利。它包含不同路線；交織性的觀點也會檢查性別如何與種族、階級、性向等處境互相影響，不能用一套固定主張概括所有女性主義者。",
		references: [{"label": "UN Women：女性主義與女性權利運動", "href": "https://interactive.unwomen.org/multimedia/timeline/womenunite/en/index.html"}],
		a: '節目沒有給教科書定義，而是從它想解決什麼講起。女性主義是一套看世界的視角，從爭取投票權、工作權一路發展而來，關心的是性別之間的權力怎麼分配。節目最貼近的理解是：它未必是要毀滅男性，而是在拆解同樣要求男性剛強、壓抑情感的那套框架。另一集也補了一句，女性主義是一個人看世界的其中一個視角，不會取代她所有的感受。',
		source: { label: 'EP49 性別大辯論（下）', href: '/blog/ep49/' },
	},
	{
		q: '什麼是「厭女」？',
		def: "misogyny 有不同的分析方式。Kate Manne 在《Down Girl》中提出的一種理解，是把厭女看作維持父權規範、懲罰被認為沒有履行性別期待的女性的機制；她也將它與替這套秩序辯護的性別歧視區分。這是具名學者的分析，不是唯一的字典定義。",
		references: [{"label": "Kate Manne《Down Girl》第3章摘要（Oxford University Press）", "href": "https://academic.oup.com/book/27451/chapter-abstract/197333686"}],
		a: "節目在 EP48 討論了性暴力、凝視與性醜聞後果的性別落差：同樣捲入事件，男性可能被說成風流，女性卻面臨蕩婦羞辱。這些是可以與厭女概念對照的討論，不代表來賓採用上方學者的完整理論。",
		source: { label: 'EP48 性別大辯論（上）', href: '/blog/ep48/' },
	},
	{
		q: '什麼是「父權體制」？',
		def: "patriarchy 指男性支配女性的社會體系。這個概念把分析焦點放在權力與制度安排，與直接判斷某一位男性的品格是不同的問題。",
		references: [{"label": "EIGE：patriarchy 詞彙表（2016）", "href": "https://eige.europa.eu/publications-resources/thesaurus/terms/1112?language_content_entity=en"}],
		a: '指一套把權力、資源與話語權主要交給男性的社會制度。節目特別強調它比較少被談的另一半：它不只給男性方便，也同時規定男性該長成什麼樣子。要剛強、要壓抑情感、隨時準備被丟去打仗或當成資本的燃料。',
		source: { label: 'EP49 性別大辯論（下）', href: '/blog/ep49/' },
	},
	{
		q: '什麼是「父權紅利」？',
		def: "patriarchal dividend 是 Connell 用來描述男性從性別支配結構中獲得的好處的概念。它不表示每位男性都過得順利，也不表示所得好處相同；男性之間的階級、種族與性向等位置，仍會影響他們的處境。",
		references: [{"label": "UC Press《Dude, You’re a Fag》第一章，第7頁（PDF）", "href": "https://content.ucpress.edu/chapters/10671001.ch01.pdf"}],
		a: '男性不必做任何事，光是身在這個結構裡就自動分到的方便，例如較少被騷擾、較少需要警戒。它之所以難討論，正因為當事人常常感覺不到。沒領到好處的感覺是真的，但那不代表紅利不存在，只代表它被分得很不平均，底層男性拿到的也很少。',
		source: { label: 'EP48 性別大辯論（上）', href: '/blog/ep48/' },
	},
	{
		q: '什麼是「霸權陽剛氣質」？',
		def: "hegemonic masculinity 關注的是：在特定時間與社會裡，哪些男性實踐被放在較高的位置，並支持性別不平等。它要放在多種陽剛氣質之間的權力關係中理解，不是一份「最像男人」的固定性格清單，也不一定是多數男性實際做得到的樣子。",
		references: [{"label": "UC Press《Dude, You’re a Fag》第一章，第7頁（PDF）", "href": "https://content.ucpress.edu/chapters/10671001.ch01.pdf"}],
		a: '同一個社會裡，各種男子氣概並不平等，總有一種被擺在最高，其他人都拿來跟它比。具體來說，強硬、能賺錢、能保護人的樣子被放在最高位置，其他活法則顯得次一等。它不必靠強迫，光是不斷出現、不斷被稱讚，就足以讓人自動對號入座。',
		source: { label: 'EP3 陽剛氣質一定要強大？', href: '/blog/ep3/' },
	},
	{
		q: '什麼是「性別腳本」？',
		def: "性腳本理論把文化提供的情境、人際互動的安排與個人慾望放在一起，理解人如何學會親密與性的互動方式。本頁使用「性別腳本」時，則是在白話描述節目裡的性別角色期待；它不等於原研究中「性腳本」的全部意義。",
		references: [{"label": "Simon、Gagnon〈Sexual scripts: Permanence and change〉摘要（1986）", "href": "https://link.springer.com/article/10.1007/BF01542219"}],
		a: '社會替不同性別預先寫好的台詞和走位。照著演不用思考就知道下一步，但久了很難分辨，自己是真的想這麼做，還是只是背得太熟。節目舉的例子包括男生走在馬路外側、搶著買單、包辦整個約會行程。',
		source: { label: 'EP2 拆解直男體貼背後的性別腳本', href: '/blog/ep2/' },
	},
	{
		q: '什麼是「情緒勞動」？',
		def: "Hochschild 的研究區分私人生活中的情緒管理（emotion work），以及被帶入有薪服務工作、成為職務要求的情緒勞動（emotional labor）。日常對話常把關係裡的安撫與照顧也叫作情緒勞動；下方節目使用的是較廣的日常說法，與原本的職場概念有別。",
		references: [{"label": "Hochschild《The Managed Heart》書介（UC Press）", "href": "https://www.ucpress.edu/books/the-managed-heart/paper"}],
		a: '照顧別人情緒所付出的、看不見卻很耗人的心力。節目的例子很具體：女生提出不同意見，男生把它當成自尊受損，於是對方得先稱讚、先安撫，再小心說出真正想法。她不只要處理議題，還得額外照顧對方的情緒。另一集裡，主持人柏文也發現自己曾把所有低潮都丟給同一個人，對方承擔了大量情緒勞動。',
		source: { label: 'EP8 身體界線怎麼學？', href: '/blog/ep8/' },
	},
	{
		q: '什麼是「善意的性別歧視」？',
		def: "benevolent sexism 是 Glick 與 Fiske 理論中的一類性別歧視：對符合傳統角色的女性，表現出看似正面的保護、理想化與親密期待，同時維持原有性別分工。它不表示所有照顧或善意都有問題，要看背後是否預設固定的性別位置。",
		references: [{"label": "Glick、Fiske〈Hostile and Benevolent Sexism〉摘要（1997）", "href": "https://journals.sagepub.com/doi/abs/10.1111/j.1471-6402.1997.tb00104.x"}],
		a: '用保護和禮遇當包裝的歧視，前提是先把對方當成需要被照顧的弱者。走外側、搶買單、接過對方手上的東西都不帶惡意，看起來也很體面，但正因為它看起來體面，反而比明著看不起更難察覺。',
		source: { label: 'EP2 約會該男生買單嗎？', href: '/blog/ep2/' },
	},
	{
		q: '什麼是「女權自助餐」？',
		a: '這是網路上常見的批評說法，指責女性「好處都拿、責任不揹」：希望男性繼續負起傳統父權要求的責任，同時還要接手過去被認為屬於女生的那一份。節目把這個說法請到現場正面討論，而不是當成不能提的禁區；主持人的回應是，那些理所當然的「男人責任」，其實同樣是一種枷鎖。',
		source: { label: 'EP48 性別大辯論（上）', href: '/blog/ep48/' },
	},
	{
		q: '什麼是「紅藥丸」？',
		def: "在男性圈的用語中，red pill 借用《駭客任務》的比喻，把接受某套「世界偏袒女性、壓迫男性」的說法形容成看清現實。這是在描述該社群的主張，不表示那些主張已被證實，也不能把所有男性求助或約會建議都歸為同一種立場。",
		references: [{"label": "UN Women：男性圈詞彙表中的 Red pill／Blue pill", "href": "https://chile.unwomen.org/en/articles/glossary/glossary-the-manosphere"}],
		a: '網路上教男性如何吸引女性的一套說法，常要求男性不要自我矮化、要掌握場面，也會把男女如何付出愛講成兩套不能重疊的規則。節目的來賓實際接觸過，他的感受是：有些話好像立刻能用，有些卻太絕對，像把複雜的人際互動切成固定答案。',
		source: { label: 'EP7 交友軟體為何讓直男焦慮？', href: '/blog/ep7/' },
	},
	{
		q: '什麼是「男性開腿」（Manspreading）？',
		def: "Merriam-Webster 用 manspreading 描述男性在公共座位上張開雙腿，侵入他人空間的行為。判斷重點是是否占用他人的空間，不是只要男性坐著或雙腿分開就算。",
		references: [{"label": "Merriam-Webster：manspreading 詞義", "href": "https://www.merriam-webster.com/dictionary/manspreading"}],
		a: '指男性在座位上大幅張開雙腿、佔用鄰座空間。支持的一方訴諸生理構造，反對的一方看到的是空間權力：女性從小被教導要縮小身體、併攏雙腿，男性則被鼓勵佔據空間、展現氣概。當一個人張開腿迫使鄰座縮小自己，那個座位上重演的是「男大女小」的關係。',
		source: { label: 'EP49 性別大辯論（下）', href: '/blog/ep49/' },
	},
	{
		q: '什麼是「Not All Men」？',
		def: "字面意思是「不是所有男人都這樣」。爭議常出在使用時機：例如別人正說明遭遇時，急著替男性群體辯解，可能讓經驗與求助被打斷。UN Women 在傾聽受害者的建議中，便提醒避免用這句話回應；這不等於主張每位男性都做過同樣的事。",
		references: [{"label": "UN Women：傾聽受害者經驗的建議", "href": "https://interactive.unwomen.org/multimedia/campaign/unpacktheeveryday/index.html"}],
		a: '意思是「不是所有男人都這樣」，被指責時最常見的那句反駁。委屈可能是真的，但節目提醒：如果對話只停在這裡，另一邊那些反覆發生、已經累積成警戒的經驗，也很容易再次被蓋過去。',
		source: { label: 'EP5 厭男到底在厭什麼？', href: '/blog/ep5/' },
	},
	{
		q: '什麼是「凝視」？為什麼被稱讚外貌會不舒服？',
		def: "Laura Mulvey 在〈Visual Pleasure and Narrative Cinema〉中，分析主流敘事電影如何把觀看與行動的位置偏向男性，讓女性成為被展示的對象。這是「男性凝視」的重要理論來源；本頁下方談日常稱讚與身體界線，是節目的延伸討論，不能直接等同於電影理論的全部內容。",
		references: [{"label": "Laura Mulvey〈Visual Pleasure and Narrative Cinema〉，收於《Issues in Feminist Film Criticism》（Indiana University Press）", "href": "https://publish.iupress.indiana.edu/read/issues-in-feminist-film-criticism/section/fa50dca1-f5b0-48bf-b719-dadaf1d3024a"}],
		a: '凝視指的是把人當成被觀看、被評價的對象，而不是有自己想法的人。稱讚外貌可能讓人開心，也可能把人當成被打量的物件；差別在於有沒有夾帶評分與慾望。另一集也點出恐懼的不對稱：同樣一句性暗示，男性聽到多半只是不適，女性在公車上或職場裡聽到，往往伴隨對人身安全的擔憂。',
		source: { label: 'EP9 政治正確有標準答案嗎？', href: '/blog/ep9/' },
	},
];

const sourcesChecked = FAQ_REVIEW_DATE;

const faqJsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	'@id': `${new URL('faq/', Astro.site).toString()}#faq`,
	inLanguage: 'zh-TW',
	mainEntity: [...FAQS, ...TERMS].map((item) => ({
		'@type': 'Question',
		name: item.q,
		acceptedAnswer: {
			'@type': 'Answer',
			text: [
				item.def && `${item.definitionLabel ?? '概念說明'}：${item.def}`,
				`節目裡的說法：${item.a}`,
				`相關單集：${item.source.label}`,
			].filter(Boolean).join('\n'),
			...(item.references?.length && {
				citation: item.references.map((reference) => ({ '@type': 'CreativeWork', name: reference.label, url: reference.href })),
			}),
		},
	})),
});
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead
			title={'常見問題'}
			description={'關於性別、女權、陽剛氣質與約會界線的常見問題，概念與法規附上參考來源，節目觀點另列相關單集。'}
			pageKind="collection"
		/>
		<script type="application/ld+json" set:html={faqJsonLd} />
		<style>
			main {
				width: min(var(--content-width), calc(100% - 2.5rem));
				max-width: none;
			}
			.faq-hero {
				padding-block: 1rem 2.5rem;
				text-align: center;
			}
			.faq-hero h1 {
				margin: 0 0 0.9rem;
				font-size: clamp(1.9rem, 5vw, 2.6rem);
			}
			.faq-hero p {
				margin: 0 auto;
				max-width: 36rem;
				color: var(--text-secondary);
				font-size: clamp(0.98rem, 2.2vw, 1.08rem);
				line-height: 1.8;
			}
			.faq-list {
				display: flex;
				flex-direction: column;
				gap: 2.25rem;
				padding-bottom: 3.5rem;
			}
			.faq-item {
				border-top: 1px solid var(--border);
				padding-top: 1.75rem;
			}
			.faq-item h3 {
				margin: 0 0 0.85rem;
				font-size: clamp(1.1rem, 2.6vw, 1.28rem);
				line-height: 1.5;
			}
			.faq-jump {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.6rem;
				padding-bottom: 2.5rem;
			}
			.faq-jump a {
				padding: 0.45rem 1rem;
				border: 1px solid var(--border);
				border-radius: 999px;
				color: var(--text-secondary);
				font-size: 0.88rem;
				text-decoration: none;
			}
			.faq-jump a:hover,
			.faq-jump a:focus-visible {
				border-color: var(--accent-pink);
				color: var(--accent-pink);
			}
			.group-heading {
				margin: 0 0 0.75rem;
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.16em;
				color: var(--accent-pink);
				scroll-margin-top: 5rem;
			}
			.group-intro {
				margin: 0 0 0.5rem;
				color: var(--text-muted);
				font-size: 0.92rem;
				line-height: 1.8;
			}
			.faq-def {
				color: var(--text-primary);
			}

			.faq-definition-label {
				font-size: 0.78rem;
				font-weight: 700;
			}
			.faq-references {
				margin: 0 0 1.25rem;
				padding-left: 1.2rem;
				font-size: 0.85rem;
				line-height: 1.75;
				color: var(--text-muted);
				overflow-wrap: anywhere;
			}
			.faq-references a {
				color: var(--accent-pink);
			}
			.faq-hero .sources-checked {
				margin-top: 1rem;
				font-size: 0.82rem;
				color: var(--text-muted);
			}
			.faq-show {
				position: relative;
				padding-left: 0.9rem;
				border-left: 2px solid var(--border);
			}
			.faq-show::before {
				content: '節目裡的說法';
				display: block;
				margin-bottom: 0.3rem;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				color: var(--text-muted);
			}
			.faq-item p {
				margin: 0 0 1rem;
				color: var(--text-secondary);
				line-height: 1.85;
			}
			.faq-source {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				font-size: 0.88rem;
				color: var(--accent-pink);
				text-decoration: none;
			}
			.faq-source:hover,
			.faq-source:focus-visible {
				text-decoration: underline;
			}
			.faq-source::before {
				content: '相關單集';
				color: var(--text-muted);
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="main-content">
			<section class="faq-hero">
				<h1>常見問題</h1>
				<p>
					這裡把「概念或法律說明」和「節目裡的說法」分開，前者附上資料來源，後者連回相關單集。
					具名學者的分析不等於唯一共識，法律說明也不能只憑一句話判定個案。
				</p>
				<p class="sources-checked">資料核對：<time datetime={sourcesChecked}>{sourcesChecked}</time>。書籍與論文連結部分為摘要或試讀，全文可能需要圖書館或出版者權限。</p>
			</section>

			<nav class="faq-jump" aria-label="頁內快速跳轉">
				<a href="#questions">常見問題（{FAQS.length}）</a>
				<a href="#terms">名詞解釋（{TERMS.length}）</a>
			</nav>

			<section aria-labelledby="questions">
				<h2 class="group-heading" id="questions">常見問題</h2>
				<div class="faq-list">
					{FAQS.map((item) => (
						<article class="faq-item">
							<h3>{item.q}</h3>
							{item.def && <div class="faq-definition">
								<p class="faq-definition-label">{item.definitionLabel ?? '概念說明'}</p>
								<p class="faq-def">{item.def}</p>
								{item.references?.length && <ul class="faq-references" aria-label="概念或法規參考資料">
									{item.references.map((reference) => <li><a href={reference.href}>{reference.label}</a></li>)}
								</ul>}
							</div>}
							<p class="faq-show">{item.a}</p>
							<a class="faq-source" href={item.source.href}>{item.source.label}</a>
						</article>
					))}
				</div>
			</section>

			<section aria-labelledby="terms">
				<h2 class="group-heading" id="terms">名詞解釋</h2>
				<p class="group-intro">
					性別議題的詞彙有不同脈絡。這裡列出概念來源，再用相關單集的故事與觀點幫助理解。
				</p>
				<div class="faq-list">
					{TERMS.map((item) => (
						<article class="faq-item">
							<h3>{item.q}</h3>
							{item.def && <div class="faq-definition">
								<p class="faq-definition-label">{item.definitionLabel ?? '概念說明'}</p>
								<p class="faq-def">{item.def}</p>
								{item.references?.length && <ul class="faq-references" aria-label="概念或法規參考資料">
									{item.references.map((reference) => <li><a href={reference.href}>{reference.label}</a></li>)}
								</ul>}
							</div>}
							<p class="faq-show">{item.a}</p>
							<a class="faq-source" href={item.source.href}>{item.source.label}</a>
						</article>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
