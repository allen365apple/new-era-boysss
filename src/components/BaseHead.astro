---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import PodcastCover from '../assets/podcast-cover.jpeg';
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
	PODCAST_NAME,
	PODCAST_HOST,
	PODCAST_LINKS,
	SOCIAL_LINKS,
	GOOGLE_SITE_VERIFICATION,
} from '../consts';

type PageKind = 'podcast' | 'collection' | 'about';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	isArticle?: boolean;
	pubDate?: Date;
	updatedDate?: Date;
	episode?: string;
	topics?: string[];
	hosts?: string;
	pageKind?: PageKind;
	jsonLdExtra?: Record<string, unknown>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const {
	title,
	description,
	image = PodcastCover,
	isArticle = false,
	pubDate,
	updatedDate,
	episode,
	topics,
	hosts,
	pageKind = 'podcast',
	jsonLdExtra = {},
} = Astro.props;

const ogImage = new URL(image.src, Astro.url);
const fullTitle = title === SITE_TITLE ? title : `${title} — ${SITE_TITLE}`;

const siteUrl = Astro.site?.toString();
const orgId = `${siteUrl}#org`;

// 站台的 Organization 節點（每頁輸出，供其他節點以 @id 參照）。
const organizationJsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Organization',
	'@id': orgId,
	name: PODCAST_NAME,
	url: siteUrl,
	logo: {
		'@type': 'ImageObject',
		url: new URL('/favicon-192x192.png', Astro.site).toString(),
		width: 192,
		height: 192,
	},
	sameAs: [...Object.values(PODCAST_LINKS), ...Object.values(SOCIAL_LINKS)],
});

// hosts 字串（「柏文、孝成、博志」）拆成 Person 陣列，供 BlogPosting 的 author 使用。
const authorPeople = hosts
	? hosts.split(/[、,，/]/).map((n) => n.trim()).filter(Boolean).map((name) => ({ '@type': 'Person', name }))
	: [];

// JSON-LD for articles
const articleJsonLd = isArticle
	? JSON.stringify({
		'@context': 'https://schema.org',
		'@type': 'BlogPosting',
		'@id': `${canonicalURL.toString()}#article`,
		url: canonicalURL.toString(),
		headline: title,
		description,
		image: { '@type': 'ImageObject', url: ogImage.toString() },
		inLanguage: 'zh-TW',
		datePublished: pubDate?.toISOString(),
		...(updatedDate && { dateModified: updatedDate.toISOString() }),
		...(episode && { identifier: episode }),
		...(topics && topics.length > 0 ? { articleSection: topics, keywords: topics.join(', ') } : {}),
		author: authorPeople.length > 0 ? authorPeople : { '@type': 'Organization', name: PODCAST_HOST },
		publisher: { '@id': orgId },
		mainEntityOfPage: {
			'@type': 'WebPage',
			'@id': canonicalURL.toString(),
		},
		isPartOf: {
			'@type': 'Blog',
			'@id': `${siteUrl}#blog`,
			name: SITE_TITLE,
			url: siteUrl,
		},
		...jsonLdExtra,
	})
	: null;

// JSON-LD for site / podcast
const siteJsonLd = !isArticle
	? JSON.stringify({
		'@context': 'https://schema.org',
		'@type': pageKind === 'collection' ? 'CollectionPage' : pageKind === 'about' ? 'AboutPage' : 'PodcastSeries',
		'@id': `${canonicalURL.toString()}#page`,
		name: pageKind === 'podcast' ? PODCAST_NAME : title,
		description: description || SITE_DESCRIPTION,
		url: canonicalURL.toString(),
		inLanguage: 'zh-TW',
		...(pageKind === 'podcast' && {
			// 收聽平台 + 社群帳號一起列入 sameAs，協助搜尋引擎與 AI 把它們認成同一個節目實體。
			sameAs: [...Object.values(PODCAST_LINKS), ...Object.values(SOCIAL_LINKS)],
		}),
		...jsonLdExtra,
	})
	: null;

// WebSite schema：只在首頁輸出，明確告訴 Google 網站名稱。
// 沒有這個，Google 會拿網域擁有者（pages.dev → Cloudflare）當站名。
const isHome = canonicalURL.pathname === '/';
const websiteJsonLd = isHome
	? JSON.stringify({
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		'@id': `${Astro.site?.toString()}#website`,
		name: PODCAST_NAME,
		alternateName: SITE_TITLE,
		url: Astro.site?.toString(),
		inLanguage: 'zh-TW',
		publisher: { '@id': orgId },
	})
	: null;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png?v=2" />
<link rel="shortcut icon" href="/favicon.ico?v=2" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="dark light" />
<meta name="theme-color" content="#f7f4f8" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#07080b" media="(prefers-color-scheme: dark)" />
{GOOGLE_SITE_VERIFICATION && (
	<meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
)}

<script is:inline>
	(() => {
		const applySavedTheme = () => {
			// 偏好可為 dark／light／system；system 依作業系統設定決定實際外觀。
			let preference = 'dark';
			try {
				const stored = localStorage.getItem('site-theme');
				if (stored === 'light' || stored === 'dark' || stored === 'system') preference = stored;
			} catch {}
			const theme = preference === 'system'
				? (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark')
				: preference;
			document.documentElement.dataset.theme = theme;
			document.documentElement.dataset.themePreference = preference;
		};

		applySavedTheme();
	})();
</script>

<!-- 思源黑體 Noto Sans TC（Google Fonts，CJK 動態子集化） -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap"
	rel="stylesheet"
/>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL.toString()} />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="description" content={description} />

<!-- Open Graph -->
<meta property="og:type" content={isArticle ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL.toString()} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage.toString()} />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="zh_TW" />
{isArticle && pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{isArticle && updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
<meta name="author" content={PODCAST_HOST} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL.toString()} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.toString()} />

<!-- JSON-LD Structured Data -->
{articleJsonLd && <script type="application/ld+json" set:html={articleJsonLd} />}
{siteJsonLd && <script type="application/ld+json" set:html={siteJsonLd} />}
{websiteJsonLd && <script type="application/ld+json" set:html={websiteJsonLd} />}
<script type="application/ld+json" set:html={organizationJsonLd} />
