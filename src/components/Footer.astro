---
import SocialLinks from './SocialLinks.astro';

const today = new Date();
---

<footer>
	<SocialLinks variant="compact" set="footer" label="節目社群與收聽平台連結" />
	<nav class="footer-nav" aria-label="頁尾導覽">
		<a href="/faq/">常見問題</a>
		<a href="/topics/">議題索引</a>
		<a href="/about/">關於節目</a>
		<a href="/admin/" target="_blank" rel="noopener noreferrer" data-astro-reload>內容管理後臺</a>
	</nav>
	<p>&copy; {today.getFullYear()} 新世紀直男戰士</p>
</footer>
<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 2.5rem 1.25rem;
		text-align: center;
		color: var(--text-muted);
		font-size: 0.9rem;
	}
	footer p {
		margin: 0;
	}
	footer :global(.social-links) {
		margin-bottom: 1.5rem;
	}
	.footer-nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		margin-bottom: 0.9rem;
	}
	.footer-nav a {
		padding: 0.15rem 0;
		color: var(--text-muted);
		font-size: 0.85rem;
		text-decoration: none;
	}
	/* 分隔線由 CSS 產生，不進無障礙朗讀 */
	.footer-nav a:not(:last-child)::after {
		content: '｜';
		color: var(--border-strong, var(--border));
		text-decoration: none;
	}
	.footer-nav a:hover,
	.footer-nav a:focus-visible {
		color: var(--text-primary);
	}
	.footer-nav a:hover::after,
	.footer-nav a:focus-visible::after {
		color: var(--border-strong, var(--border));
	}
</style>
