---
import SocialLinks from './SocialLinks.astro';

const today = new Date();
---

<footer>
	<SocialLinks variant="compact" label="節目社群連結" />
	<p>&copy; {today.getFullYear()} 新世紀直男戰士</p>
	<p class="sub">部分文章由 AI 協助整理 Podcast 內容，通過內容與敏感資訊檢查後發布</p>
	<a class="admin-link expand-animation scale-animation" href="/admin/" target="_blank" rel="noopener noreferrer" data-astro-reload>內容管理後臺 ↗</a>
</footer>
<style>
	footer {
		border-top: 1px solid var(--border);
		padding: 2.5rem 1.25rem;
		text-align: center;
		color: var(--text-muted);
		font-size: 0.9rem;
	}
	footer p {
		margin: 0;
	}
	footer :global(.social-links) {
		margin-bottom: 1.5rem;
	}
	footer .sub {
		font-size: 0.82rem;
		margin-top: 0.3rem;
	}
	.admin-link {
		display: inline-flex;
		margin-top: 1rem;
		padding: 0.28rem 0.65rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		color: var(--text-muted);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
	}
	.admin-link:hover {
		color: var(--text-primary);
		border-color: var(--border-strong);
	}
</style>
