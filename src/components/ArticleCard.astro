---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import PodcastCover from '../assets/podcast-cover.jpeg';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	variant?: 'list' | 'grid';
}

const { post, variant = 'list' } = Astro.props;
const image = post.data.coverImage ?? PodcastCover;
const imageAlt = post.data.coverImage ? post.data.title : '新世紀直男戰士 Podcast 封面';
---

<a
	href={`/blog/${post.id}/`}
	class:list={['card-link', variant]}
	data-pub-date={post.data.pubDate.toISOString()}
>
	<article class:list={['post-card', variant]}>
		<div class="thumb">
			<Image width={300} height={300} src={image} alt={imageAlt} />
			<span class="thumb-shade" aria-hidden="true"></span>
			<span class="thumb-arrow" aria-hidden="true">›</span>
		</div>
		<div class="body">
			<div class="tags">
				{post.data.episode && <span class="episode-tag">{post.data.episode}</span>}
				{post.data.topics?.slice(0, 2).map((topic) => <span class="topic-tag">{topic}</span>)}
			</div>
			<h2>{post.data.title}</h2>
			<p class="desc">{post.data.description}</p>
			<span class="date"><FormattedDate date={post.data.pubDate} /></span>
		</div>
	</article>
</a>

<style>
	.card-link {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.post-card {
		display: grid;
		grid-template-columns: 150px minmax(0, 1fr);
		gap: 1.5rem;
		padding: 1.75rem 0;
		border-top: 1px dashed var(--border);
		align-items: center;
	}
	.card-link.list:last-child .post-card {
		border-bottom: 1px dashed var(--border);
	}
	.thumb {
		position: relative;
		border-radius: var(--radius);
		overflow: hidden;
		aspect-ratio: 1 / 1;
		background: var(--surface-soft);
	}
	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.3s ease;
	}
	.card-link:hover .thumb img {
		transform: scale(1.04);
	}
	.thumb-shade,
	.thumb-arrow {
		position: absolute;
		inset: 0;
		pointer-events: none;
		transition: opacity 0.2s ease, transform 0.2s ease;
	}
	.thumb-shade {
		background: var(--image-hover-overlay);
		opacity: 0;
	}
	.thumb-arrow {
		display: grid;
		place-items: center;
		color: var(--on-solid);
		font-size: 3rem;
		font-weight: 300;
		opacity: 0;
		transform: scale(0.5);
	}
	.card-link:hover .thumb-shade,
	.card-link:hover .thumb-arrow {
		opacity: 1;
	}
	.card-link:hover .thumb-arrow {
		transform: scale(1);
	}
	.card-link:active .thumb {
		transform: scale(0.95);
	}
	.body {
		min-width: 0;
	}
	.tags {
		display: flex;
		gap: 0.4rem;
		flex-wrap: wrap;
		margin-bottom: 0.5rem;
	}
	.episode-tag,
	.topic-tag {
		font-size: 0.72rem;
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
	}
	.episode-tag {
		background: var(--accent);
		color: var(--on-accent);
		font-weight: 600;
	}
	.topic-tag {
		background: var(--topic-chip-background);
		color: var(--topic-chip-text);
		font-weight: 500;
	}
	h2 {
		font-size: 1.3rem;
		margin: 0 0 0.4rem;
		color: var(--text-primary);
		line-height: 1.4;
		transition: color 0.15s ease;
	}
	h2::after {
		content: '›';
		display: inline-block;
		margin-left: 0.2em;
		color: var(--accent);
		opacity: 0;
		transform: translateX(-0.25rem);
		transition: opacity 0.2s ease, transform 0.2s ease;
	}
	.card-link:hover h2::after {
		opacity: 1;
		transform: translateX(0);
	}
	.card-link:hover h2 {
		color: var(--accent);
	}
	.desc {
		color: var(--text-secondary);
		font-size: 0.95rem;
		margin: 0 0 0.5rem;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.date {
		color: var(--text-muted);
		font-size: 0.85rem;
	}
	.card-link.grid {
		height: 100%;
	}
	.post-card.grid {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 0;
		gap: 0;
		border: 1px solid var(--border);
		background: var(--surface-soft);
		overflow: hidden;
	}
	.post-card.grid .thumb {
		aspect-ratio: 1 / 1;
		border-radius: 0;
	}
	.post-card.grid .thumb img {
		object-fit: contain;
	}
	.post-card.grid .body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: 1.15rem;
	}
	.post-card.grid h2 {
		font-size: 1.12rem;
	}
	.post-card.grid .date {
		margin-top: auto;
		padding-top: 0.35rem;
	}
	@media (max-width: 640px) {
		.post-card.list {
			grid-template-columns: 96px minmax(0, 1fr);
			gap: 1rem;
		}
	}
</style>
