---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<a href="#main-content" class="skip-link">跳到主要內容</a>
	<nav>
		<a href="/" class="brand">
			<img src="/favicon-192x192.png" alt="" width="38" height="38" />
			<span>{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/blog/">文章</HeaderLink>
			<HeaderLink href="/topics/">議題</HeaderLink>
			<HeaderLink href="/about/">關於節目</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--header-background);
		backdrop-filter: saturate(180%) blur(12px);
		border-bottom: 1px solid var(--border);
	}
	.skip-link {
		position: absolute;
		left: 1rem;
		top: 0.5rem;
		padding: 0.5rem 0.8rem;
		background: var(--surface);
		color: var(--text-primary);
		border: 2px solid var(--accent);
		border-radius: var(--radius);
		transform: translateY(-200%);
		transition: transform 0.15s ease;
		z-index: 100;
	}
	.skip-link:focus {
		transform: translateY(0);
	}
	nav {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.25rem;
		height: 68px;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--text-primary);
		letter-spacing: -0.02em;
		text-decoration: none;
	}
	.brand img {
		width: 38px;
		height: 38px;
		object-fit: cover;
		border-radius: 4px;
	}
	.internal-links {
		display: flex;
		gap: 0.5rem;
	}
	nav :global(a:not(.brand)) {
		padding: 0.4rem 0.75rem;
		color: var(--text-secondary);
		border-radius: var(--radius);
		text-decoration: none;
		font-size: 0.95rem;
		transition: background 0.15s ease, color 0.15s ease;
	}
	nav :global(a.active),
	nav :global(a:not(.brand):hover) {
		color: var(--text-primary);
		background: var(--surface-soft);
	}
	@media (max-width: 520px) {
		nav {
			padding: 0 0.8rem;
		}
		.brand span {
			display: none;
		}
		.internal-links {
			gap: 0;
		}
		nav :global(a:not(.brand)) {
			padding-inline: 0.55rem;
			font-size: 0.86rem;
		}
	}
</style>
