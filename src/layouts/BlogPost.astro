---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import SiteBanner from '../components/SiteBanner.astro';
import { TOPICS } from '../data/topics';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: MarkdownHeading[];
	relatedPosts?: CollectionEntry<'blog'>[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	coverImage,
	episode,
	episodeTitle,
	hosts,
	guests,
	topics,
	listenLinks,
	aiGenerated,
	headings = [],
	relatedPosts = [],
} = Astro.props;

function confirmedEpisodeLink(platform: 'soundon' | 'spotify' | 'apple' | 'kkbox', value?: string) {
	if (!value) return undefined;
	try {
		const url = new URL(value);
		if (platform === 'soundon') return url.hostname === 'player.soundon.fm' && url.pathname.includes('/episodes/') ? value : undefined;
		if (platform === 'spotify') return url.hostname === 'open.spotify.com' && url.pathname.includes('/episode/') ? value : undefined;
		if (platform === 'apple') return url.hostname === 'podcasts.apple.com' && url.searchParams.has('i') ? value : undefined;
		if (platform === 'kkbox') return url.hostname.endsWith('kkbox.com') && url.pathname !== '/' ? value : undefined;
	} catch {
		return undefined;
	}
}

// 文章頁只顯示格式正確的單集連結，避免把平台首頁或節目總頁誤當成單集頁。
const effectiveListenLinks = {
	soundon: confirmedEpisodeLink('soundon', listenLinks?.soundon),
	spotify: confirmedEpisodeLink('spotify', listenLinks?.spotify),
	apple: confirmedEpisodeLink('apple', listenLinks?.apple),
	kkbox: confirmedEpisodeLink('kkbox', listenLinks?.kkbox),
};
const hasListenLinks = Object.values(effectiveListenLinks).some(Boolean);
const displayEpisodeTitle = episodeTitle
	? episode && episodeTitle.trim().toUpperCase().startsWith(episode.toUpperCase())
		? episodeTitle
		: episode
			? `${episode}：${episodeTitle}`
			: episodeTitle
	: undefined;

// 只取 h2 / h3 進目錄
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const topicLinks = (topics ?? [])
	.map((name) => ({ name, slug: TOPICS.find((topic) => topic.name === name)?.slug }))
	.filter((topic): topic is { name: string; slug: string } => Boolean(topic.slug));
---

<html lang="zh-TW">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={coverImage}
			isArticle={true}
			pubDate={pubDate}
			updatedDate={updatedDate}
			episode={episode}
			topics={topics}
		/>
		<style>
			article {
				width: min(1320px, calc(100% - 2rem));
				margin: 0 auto;
				background: var(--surface-soft);
				border: 1px solid var(--border);
				border-radius: var(--radius-large);
				box-shadow: var(--box-shadow);
				overflow: hidden;
			}
			.hero {
				max-width: 920px;
				margin: 0 auto;
				padding: 3.5rem 1.25rem 2rem;
				text-align: center;
				border-bottom: 1px dashed var(--border);
			}
			.hero .meta-top {
				display: flex;
				justify-content: center;
				gap: 0.5rem;
				flex-wrap: wrap;
				margin-bottom: 1rem;
			}
			.episode-tag {
				background: var(--accent);
				color: #fff;
				font-size: 0.78rem;
				font-weight: 600;
				padding: 0.2rem 0.7rem;
				border-radius: 999px;
			}
			.topic-tag {
				background: var(--topic-chip-background);
				color: var(--topic-chip-text);
				font-size: 0.78rem;
				font-weight: 500;
				padding: 0.2rem 0.7rem;
				border-radius: 999px;
			}
			.hero h1 {
				font-size: 2.6rem;
				margin: 0 0 1rem;
			}
			.hero .date {
				color: var(--text-muted);
				font-size: 0.95rem;
			}
			.hero .guests {
				color: var(--text-secondary);
				font-size: 0.95rem;
				margin-top: 0.4rem;
			}
			.cover {
				margin: 2rem auto 0;
				padding: 0 1.25rem;
				text-align: center;
			}
			.cover img {
				max-width: 480px;
				width: 100%;
				height: auto;
				border-radius: var(--radius-lg);
			}

			/* 兩欄:目錄 + 內文 */
			.layout {
				display: grid;
				grid-template-columns: 220px minmax(0, var(--content-width)) 190px;
				gap: 2rem;
				justify-content: center;
				padding: 3rem 1.25rem 4rem;
				align-items: start;
			}
			.toc {
				position: sticky;
				top: 6rem;
				font-size: 0.9rem;
			}
			.toc-label {
				text-transform: uppercase;
				letter-spacing: 0.08em;
				font-size: 0.72rem;
				color: var(--text-muted);
				font-weight: 600;
				margin-bottom: 0.8rem;
				padding-bottom: 0.8rem;
				border-bottom: 1px dashed var(--border);
			}
			.toc ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.3rem;
			}
			.toc a {
				color: var(--text-muted);
				text-decoration: none;
				display: block;
				line-height: 1.4;
				padding: 0.4rem 0.7rem;
				border-left: 2px solid transparent;
				border-radius: 6px;
				transition: all 0.15s ease;
			}
			.toc a.depth-3 {
				padding-left: 1.4rem;
				font-size: 0.85rem;
			}
			.toc a:hover {
				color: var(--text-secondary);
			}
			.toc a.active {
				color: var(--accent);
				font-weight: 500;
				background: var(--accent-light);
				border-left-color: var(--accent);
			}
			.article {
				min-width: 0;
			}
			.taxonomy {
				position: sticky;
				top: 6rem;
				display: grid;
				gap: 1.25rem;
				align-self: start;
			}
			.taxonomy-section {
				padding-bottom: 1.1rem;
				border-bottom: 1px dashed var(--border);
			}
			.taxonomy-label {
				margin: 0 0 0.7rem;
				color: var(--text-muted);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.09em;
				text-transform: uppercase;
			}
			.taxonomy-link,
			.taxonomy-tag {
				display: inline-flex;
				align-items: center;
				min-height: 34px;
				padding: 0.3rem 0.7rem;
				border-radius: 0.6rem;
				color: var(--text-secondary);
				font-size: 0.82rem;
				font-weight: 600;
			}
			.taxonomy-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
			}
			.taxonomy-tag {
				background: var(--topic-chip-background);
				color: var(--topic-chip-text);
			}
			.taxonomy-link:hover,
			.taxonomy-tag:hover {
				color: var(--accent);
			}

			/* 頂部：來源說明與主要收聽入口 */
			.episode-listen-intro {
				background: var(--surface-soft);
				border: 1px dashed var(--border-strong);
				border-radius: var(--radius-lg);
				padding: 1.4rem 1.5rem;
				margin-bottom: 1.8rem;
			}
			.episode-listen-intro p {
				margin: 0;
				color: var(--text-secondary);
				font-size: 0.92rem;
				line-height: 1.7;
			}
			.episode-listen-intro .source-title {
				font-weight: 500;
				color: var(--text-primary);
			}
			.episode-listen-intro .accuracy-note {
				margin-top: 0.45rem;
			}
			.episode-listen-intro .listen-links {
				margin-top: 1rem;
			}
			.episode-intro-divider {
				margin: 0 0 2.5rem;
				border: 0;
				border-top: 1px solid var(--border);
			}
			.related {
				margin-top: 2.5rem;
				padding-top: 2rem;
				border-top: 1px dashed var(--border);
			}
			.related h2 {
				font-size: 1.2rem;
				margin: 0 0 1rem;
				padding: 0;
				border: 0;
			}
			.related ul {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				gap: 0.75rem;
			}
			.related a {
				display: block;
				padding: 0.75rem 0.9rem;
				background: var(--surface-soft);
				border-radius: var(--radius);
				color: var(--text-primary);
			}
			.related a:hover {
				color: var(--accent);
			}
			.related .related-meta {
				display: block;
				margin-top: 0.2rem;
				font-size: 0.82rem;
				color: var(--text-muted);
			}
			.article :global(h2),
			.article :global(h3) {
				scroll-margin-top: 6.5rem;
			}

			.listen-links {
				display: flex;
				gap: 0.6rem;
				flex-wrap: wrap;
			}
			.listen-links a {
				display: inline-flex;
				align-items: center;
				padding: 0.5rem 1.1rem;
				border-radius: 999px;
				font-size: 0.85rem;
				font-weight: 600;
				color: #fff;
				transition: transform 0.15s ease, opacity 0.15s ease;
			}
			.listen-links a:hover {
				transform: translateY(-1px);
				opacity: 0.92;
			}
			.btn-soundon { background: var(--platform-soundon); }
			.btn-spotify { background: var(--platform-spotify); }
			.btn-apple   { background: var(--platform-apple); }
			.btn-kkbox   { background: var(--platform-kkbox); }
			.no-links-notice {
				color: var(--text-muted);
				font-size: 0.88rem;
			}
			.closing-listen {
				margin-top: 1.5rem;
				color: var(--text-secondary);
				font-size: 0.92rem;
			}
			.closing-listen p {
				margin: 0;
			}
			.closing-listen .closing-links {
				margin-top: 0.35rem;
			}
			.closing-listen a {
				color: var(--accent);
				font-weight: 500;
				text-decoration: underline;
				text-underline-offset: 0.18em;
			}

			@media (max-width: 1260px) {
				.layout {
					grid-template-columns: minmax(0, var(--content-width)) 190px;
				}
				.toc {
					display: none;
				}
			}
			@media (max-width: 940px) {
				.layout {
					grid-template-columns: minmax(0, var(--content-width));
				}
				.taxonomy {
					position: static;
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}
			@media (max-width: 720px) {
				article {
					width: calc(100% - 1rem);
				}
				.hero {
					padding-top: 2rem;
				}
				.hero h1 {
					font-size: 1.9rem;
				}
				.taxonomy {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<SiteBanner />
		<main id="main-content" class="transition-swup-fade onload-animation" style="width: 100%; max-width: 100%; padding: 0;">
			<article>
				<div class="hero">
					<div class="meta-top">
						{episode && <span class="episode-tag">{episode}</span>}
						{topics && topics.map((t) => <span class="topic-tag">{t}</span>)}
					</div>
					<h1>{title}</h1>
					<div class="date">
						<FormattedDate date={pubDate} />
						{updatedDate && <span> · 最後更新 <FormattedDate date={updatedDate} /></span>}
					</div>
					{guests && <p class="guests">來賓:{guests}</p>}
				</div>

				{coverImage && (
					<div class="cover">
						<Image src={coverImage} alt={title} />
					</div>
				)}

				<div class="layout">
					{toc.length > 0 && (
						<nav class="toc" aria-label="文章目錄">
							<div class="toc-label">本文目錄</div>
							<ul>
								{toc.map((h) => (
									<li>
										<a href={`#${h.slug}`} class={`depth-${h.depth}`} data-toc-link={h.slug}>
											{h.text}
										</a>
									</li>
								))}
							</ul>
						</nav>
					)}

					<div class="article prose prose-base custom-md" data-article-body>
						{episode && aiGenerated && (
							<section class="episode-listen-intro" aria-label="內容來源與收聽連結">
								<p class="source-title">本文內容由 AI 整理自《新世紀直男戰士》{displayEpisodeTitle ?? episode}</p>
								<p class="accuracy-note">AI 整理可能有些許誤差，詳細內容歡迎收聽本集節目：</p>
								{hasListenLinks ? (
									<div class="listen-links">
										{effectiveListenLinks.soundon && <a href={effectiveListenLinks.soundon} target="_blank" rel="noopener noreferrer" class="btn-soundon scale-animation">SoundOn</a>}
										{effectiveListenLinks.spotify && <a href={effectiveListenLinks.spotify} target="_blank" rel="noopener noreferrer" class="btn-spotify scale-animation">Spotify</a>}
										{effectiveListenLinks.apple && <a href={effectiveListenLinks.apple} target="_blank" rel="noopener noreferrer" class="btn-apple scale-animation">Apple Podcasts</a>}
										{effectiveListenLinks.kkbox && <a href={effectiveListenLinks.kkbox} target="_blank" rel="noopener noreferrer" class="btn-kkbox scale-animation">KKBOX</a>}
									</div>
								) : (
									<p class="no-links-notice">收聽連結將於整理完成後加入。</p>
								)}
							</section>
						)}
						{episode && aiGenerated && <hr class="episode-intro-divider" />}
						<slot />

						{displayEpisodeTitle && (
							<div class="closing-listen">
								<p>更多詳細內容，歡迎收聽《新世紀直男戰士》{displayEpisodeTitle}</p>
								{hasListenLinks && (
									<p class="closing-links">
										{effectiveListenLinks.soundon && <a href={effectiveListenLinks.soundon} target="_blank" rel="noopener noreferrer">SoundOn</a>}
										{effectiveListenLinks.soundon && (effectiveListenLinks.spotify || effectiveListenLinks.apple || effectiveListenLinks.kkbox) && ' ・ '}
										{effectiveListenLinks.spotify && <a href={effectiveListenLinks.spotify} target="_blank" rel="noopener noreferrer">Spotify</a>}
										{effectiveListenLinks.spotify && (effectiveListenLinks.apple || effectiveListenLinks.kkbox) && ' ・ '}
										{effectiveListenLinks.apple && <a href={effectiveListenLinks.apple} target="_blank" rel="noopener noreferrer">Apple Podcasts</a>}
										{effectiveListenLinks.apple && effectiveListenLinks.kkbox && ' ・ '}
										{effectiveListenLinks.kkbox && <a href={effectiveListenLinks.kkbox} target="_blank" rel="noopener noreferrer">KKBOX</a>}
									</p>
								)}
							</div>
						)}

						{relatedPosts.length > 0 && (
							<section class="related" aria-labelledby="related-heading">
								<h2 id="related-heading">你可能也會想讀</h2>
								<ul>
									{relatedPosts.map((related) => (
										<li>
											<a href={`/blog/${related.id}/`}>
												{related.data.title}
												<span class="related-meta">
													{related.data.episode ? `${related.data.episode} · ` : ''}
													<FormattedDate date={related.data.pubDate} />
												</span>
											</a>
										</li>
									))}
								</ul>
							</section>
						)}
					</div>

					<aside class="taxonomy" aria-label="文章分類與議題標籤">
						<div class="taxonomy-section">
							<p class="taxonomy-label">CATEGORY</p>
							<a class="taxonomy-link expand-animation scale-animation" href="/blog/">節目文章</a>
						</div>
						{topicLinks.length > 0 && (
							<div class="taxonomy-section">
								<p class="taxonomy-label">TAGS</p>
								<div class="taxonomy-tags">
									{topicLinks.map((topic) => (
										<a class="taxonomy-tag scale-animation" href={`/topics/${topic.slug}/`}>{topic.name}</a>
									))}
								</div>
							</div>
						)}
						{episode && (
							<div class="taxonomy-section">
								<p class="taxonomy-label">EPISODE</p>
								<a class="taxonomy-link expand-animation scale-animation" href={`/blog/${episode.toLowerCase()}/`}>{episode}</a>
							</div>
						)}
					</aside>
				</div>
			</article>
		</main>
		<Footer />

	</body>
</html>
