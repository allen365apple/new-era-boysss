---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import PodcastCover from '../assets/podcast-cover.jpeg';
import { TOPICS } from '../data/topics';
import { PODCAST_NAME, PODCAST_LINKS, SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: MarkdownHeading[];
	relatedPosts?: CollectionEntry<'blog'>[];
};

const {
	title,
	description,
	pubDate,
	episodeDate,
	updatedDate,
	coverImage,
	heroImage,
	videoUrl,
	episode,
	episodeTitle,
	hosts,
	guests,
	topics,
	listenLinks,
	aiGenerated,
	headings = [],
	relatedPosts = [],
} = Astro.props;

function confirmedEpisodeLink(platform: 'soundon' | 'spotify' | 'apple' | 'kkbox', value?: string) {
	if (!value) return undefined;
	try {
		const url = new URL(value);
		if (platform === 'soundon') return url.hostname === 'player.soundon.fm' && url.pathname.includes('/episodes/') ? value : undefined;
		if (platform === 'spotify') return url.hostname === 'open.spotify.com' && url.pathname.includes('/episode/') ? value : undefined;
		if (platform === 'apple') return url.hostname === 'podcasts.apple.com' && url.searchParams.has('i') ? value : undefined;
		if (platform === 'kkbox') return url.hostname.endsWith('kkbox.com') && url.pathname !== '/' ? value : undefined;
	} catch {
		return undefined;
	}
}

// 文章頁只顯示格式正確的單集連結，避免把平台首頁或節目總頁誤當成單集頁。
const effectiveListenLinks = {
	soundon: confirmedEpisodeLink('soundon', listenLinks?.soundon),
	spotify: confirmedEpisodeLink('spotify', listenLinks?.spotify),
	apple: confirmedEpisodeLink('apple', listenLinks?.apple),
	kkbox: confirmedEpisodeLink('kkbox', listenLinks?.kkbox),
};
const hasListenLinks = Object.values(effectiveListenLinks).some(Boolean);
const articleImage = heroImage ?? coverImage;
const isWideImage = articleImage && articleImage.width > articleImage.height;
const displayEpisodeTitle = episodeTitle
	? episode && episodeTitle.trim().toUpperCase().startsWith(episode.toUpperCase())
		? episodeTitle
		: episode
			? `${episode}：${episodeTitle}`
			: episodeTitle
	: undefined;

// 只取 h2 / h3 進目錄
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const topicLinks = (topics ?? [])
	.map((name) => ({ name, slug: TOPICS.find((topic) => topic.name === name)?.slug }))
	.filter((topic): topic is { name: string; slug: string } => Boolean(topic.slug));

// ── 結構化資料（供 Google 與 AI 理解「這是一集 Podcast 的文字版」）────────────
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const episodeImage = new URL((articleImage ?? PodcastCover).src, Astro.url).toString();

// 「柏文、孝成、博志」→ Person 陣列，供 PodcastEpisode 標記主持人與來賓。
function toPeople(value?: string) {
	if (!value) return [];
	return value
		.split(/[、,，/]/)
		.map((name) => name.trim())
		.filter(Boolean)
		.map((name) => ({ '@type': 'Person', name }));
}

const episodeNumber = episode ? Number(/\d+/.exec(episode)?.[0]) : undefined;
const hostPeople = toPeople(hosts);
const guestPeople = toPeople(guests);
// 已確認的連結是平台播放頁，不是實際音訊檔，不能當作 contentUrl。
const episodePlatformUrls = Object.values(effectiveListenLinks).filter(Boolean);

const podcastEpisodeJsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'PodcastEpisode',
	'@id': `${canonicalURL.toString()}#podcast-episode`,
	url: canonicalURL.toString(),
	name: displayEpisodeTitle ?? title,
	description,
	image: episodeImage,
	inLanguage: 'zh-TW',
	datePublished: (episodeDate ?? pubDate).toISOString(),
	...(Number.isFinite(episodeNumber) && { episodeNumber }),
	...(hostPeople.length > 0 && { author: hostPeople, creator: hostPeople }),
	...(guestPeople.length > 0 && { actor: guestPeople }),
	...(episodePlatformUrls.length > 0 && { sameAs: episodePlatformUrls }),
	partOfSeries: {
		'@type': 'PodcastSeries',
		name: PODCAST_NAME,
		url: Astro.site?.toString(),
		sameAs: Object.values(PODCAST_LINKS),
	},
	subjectOf: { '@id': `${canonicalURL.toString()}#article` },
});

const breadcrumbJsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: SITE_TITLE, item: Astro.site?.toString() },
		{ '@type': 'ListItem', position: 2, name: '所有文章', item: new URL('blog/', Astro.site).toString() },
		{ '@type': 'ListItem', position: 3, name: title, item: canonicalURL.toString() },
	],
});
---

<html lang="zh-TW">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={articleImage}
			isArticle={true}
			pubDate={pubDate}
			updatedDate={updatedDate}
			episode={episode}
			topics={topics}
			hosts={hosts}
		/>
		<script type="application/ld+json" set:html={podcastEpisodeJsonLd} />
		<script type="application/ld+json" set:html={breadcrumbJsonLd} />
		<style>
			.hero {
				max-width: 920px;
				margin: 0 auto;
				padding: 3.5rem 1.25rem 2rem;
				text-align: center;
				border-bottom: 1px dashed var(--border);
			}
			.hero h1 {
				font-size: 2.6rem;
				margin: 0 0 1rem;
			}
			.hero .date {
				color: var(--text-muted);
				font-size: 0.95rem;
			}
			.hero .guests {
				color: var(--text-secondary);
				font-size: 0.95rem;
				margin-top: 0.4rem;
			}
			.cover {
				margin: 2rem auto 0;
				padding: 0 1.25rem;
				text-align: center;
			}
			.cover img {
				max-width: 480px;
				width: 100%;
				height: auto;
				border-radius: var(--radius-lg);
			}
			.cover.wide img {
				max-width: 860px;
			}
			.video-intro {
				width: min(860px, calc(100% - 2.5rem));
				margin: 1rem auto 0;
				padding: 1.25rem;
				box-sizing: border-box;
				border: 1px solid var(--border);
				border-radius: var(--radius-lg);
				background: var(--surface-soft);
				display: flex;
				align-items: center;
				justify-content: space-between;
				flex-wrap: wrap;
				gap: 1rem;
			}
			.video-intro p {
				margin: 0.3rem 0 0;
				color: var(--text-secondary);
			}
			.video-button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-height: 44px;
				padding: 0.6rem 1rem;
				box-sizing: border-box;
				border-radius: var(--radius);
				background: var(--accent);
				color: var(--on-accent);
				font-weight: 600;
				text-decoration: none;
			}

			/* 兩欄:目錄 + 內文 */
			.layout {
				display: grid;
				grid-template-columns: 240px minmax(0, var(--content-width));
				gap: 3.5rem;
				justify-content: center;
				padding: 3rem 1.25rem 4rem;
				align-items: start;
			}
			.article-sidebar {
				position: sticky;
				top: 6rem;
				display: grid;
				gap: 2rem;
			}
			.toc {
				font-size: 0.9rem;
			}
			.toc-label {
				text-transform: uppercase;
				letter-spacing: 0.08em;
				font-size: 0.72rem;
				color: var(--text-muted);
				font-weight: 600;
				margin-bottom: 0.8rem;
				padding-bottom: 0.8rem;
				border-bottom: 1px dashed var(--border);
			}
			.toc ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-direction: column;
				gap: 0.3rem;
			}
			.toc a {
				color: var(--text-muted);
				text-decoration: none;
				display: block;
				line-height: 1.4;
				padding: 0.4rem 0.7rem;
				border-left: 2px solid transparent;
				border-radius: 6px;
				transition: all 0.15s ease;
			}
			.toc a.depth-3 {
				padding-left: 1.4rem;
				font-size: 0.85rem;
			}
			.toc a:hover {
				color: var(--text-secondary);
			}
			.toc a.active {
				color: var(--accent);
				font-weight: 500;
				background: var(--accent-light);
				border-left-color: var(--accent);
			}
			.article {
				min-width: 0;
			}
			.taxonomy {
				display: grid;
				gap: 1.15rem;
			}
			.taxonomy-section {
				padding-bottom: 1rem;
				border-bottom: 1px dashed var(--border);
			}
			.taxonomy-label {
				margin: 0 0 0.65rem;
				color: var(--text-muted);
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.09em;
				text-transform: uppercase;
			}
			.taxonomy-link,
			.taxonomy-tag {
				display: inline-flex;
				align-items: center;
				min-height: 34px;
				padding: 0.3rem 0.7rem;
				border-radius: 0.6rem;
				color: var(--text-secondary);
				font-size: 0.82rem;
				font-weight: 600;
			}
			.taxonomy-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
			}
			.taxonomy-tag {
				background: var(--topic-chip-background);
				color: var(--topic-chip-text);
				overflow: hidden;
				transition: color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
			}
			.taxonomy-tag::before {
				z-index: 0;
			}
			.taxonomy-tag > span {
				position: relative;
				z-index: 1;
			}
			.taxonomy-tag:hover {
				transform: translateY(-2px);
				box-shadow: var(--tag-hover-shadow);
			}
			.taxonomy-tag:active {
				transform: translateY(0) scale(0.95);
			}
			.taxonomy-link:hover,
			.taxonomy-tag:hover {
				color: var(--accent);
			}

			/* 頂部：來源說明與主要收聽入口 */
			.episode-listen-intro {
				background: var(--surface-soft);
				border: 1px dashed var(--border-strong);
				border-radius: var(--radius-lg);
				padding: 1.4rem 1.5rem;
				margin-bottom: 1.8rem;
			}
			.episode-listen-intro p {
				margin: 0;
				color: var(--text-secondary);
				font-size: 0.92rem;
				line-height: 1.7;
			}
			.episode-listen-intro .source-title {
				font-weight: 500;
				color: var(--text-primary);
			}
			.episode-listen-intro .accuracy-note {
				margin-top: 0.45rem;
			}
			.episode-listen-intro .listen-links {
				margin-top: 1rem;
			}
			.episode-intro-divider {
				margin: 0 0 2.5rem;
				border: 0;
				border-top: 1px solid var(--border);
			}
			.related {
				margin-top: 2.5rem;
				padding-top: 2rem;
				border-top: 1px dashed var(--border);
			}
			.related h2 {
				font-size: 1.2rem;
				margin: 0 0 1rem;
				padding: 0;
				border: 0;
			}
			.related ul {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				gap: 0.75rem;
			}
			.related a {
				display: block;
				padding: 0.75rem 0.9rem;
				background: var(--surface-soft);
				border-radius: var(--radius);
				color: var(--text-primary);
			}
			.related a:hover {
				color: var(--accent);
			}
			.related .related-meta {
				display: block;
				margin-top: 0.2rem;
				font-size: 0.82rem;
				color: var(--text-muted);
			}
			.article :global(h2),
			.article :global(h3) {
				scroll-margin-top: 6.5rem;
			}

			.listen-links {
				display: flex;
				gap: 0.6rem;
				flex-wrap: wrap;
			}
			.listen-links a {
				display: inline-flex;
				align-items: center;
				padding: 0.5rem 1.1rem;
				border-radius: 999px;
				font-size: 0.85rem;
				font-weight: 600;
				color: #fff;
				transition: transform 0.15s ease, opacity 0.15s ease;
			}
			.listen-links a:hover {
				transform: translateY(-1px);
				opacity: 0.92;
			}
			.btn-soundon { background: var(--platform-soundon); }
			.btn-spotify { background: var(--platform-spotify); }
			.btn-apple   { background: var(--platform-apple); }
			.btn-kkbox   { background: var(--platform-kkbox); }
			.no-links-notice {
				color: var(--text-muted);
				font-size: 0.88rem;
			}
			.closing-listen {
				margin-top: 1.5rem;
				color: var(--text-secondary);
				font-size: 0.92rem;
			}
			.closing-listen p {
				margin: 0;
			}
			.closing-listen .closing-links {
				margin-top: 0.35rem;
			}
			.closing-listen a {
				color: var(--accent);
				font-weight: 500;
				text-decoration: underline;
				text-underline-offset: 0.18em;
			}

			@media (max-width: 1024px) {
				.layout {
					grid-template-columns: minmax(0, var(--content-width));
				}
				.article-sidebar {
					display: none;
				}
			}
			@media (max-width: 720px) {
				.hero {
					padding-top: 2rem;
				}
				.hero h1 {
					font-size: 1.9rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main id="main-content" class="transition-swup-fade onload-animation" style="width: 100%; max-width: 100%; padding: 0;">
			<article>
				<div class="hero">
					<h1>{title}</h1>
					<div class="date">
						<span>文章發布 <FormattedDate date={pubDate} /></span>
						{episodeDate && <span> · 節目上線 <FormattedDate date={episodeDate} /></span>}
						{updatedDate && <span> · 最後更新 <FormattedDate date={updatedDate} /></span>}
					</div>
					{guests && <p class="guests">來賓:{guests}</p>}
				</div>

				{articleImage && (
					<div class:list={['cover', { wide: isWideImage }]}>
						<Image src={articleImage} alt={title} width={isWideImage ? 860 : 480} widths={isWideImage ? [480, 860, 1280, 1720] : [360, 480, 720, 960]} sizes={isWideImage ? '(max-width: 900px) 92vw, 860px' : '(max-width: 520px) 92vw, 480px'} loading={videoUrl ? 'eager' : 'lazy'} />
					</div>
				)}
				{videoUrl && (
					<section class="video-intro" aria-label="本集影片版">
						<div>
							<strong>本集有影片版</strong>
							<p>想看完整對談與現場互動？歡迎到 YouTube 觀看！</p>
						</div>
						<a class="video-button" href={videoUrl} target="_blank" rel="noopener noreferrer">前往 YouTube 看完整影片 ↗</a>
					</section>
				)}

				<div class="layout">
					<aside class="article-sidebar" aria-label="文章導覽與分類">
						{toc.length > 0 && (
							<nav class="toc" aria-label="文章目錄">
								<div class="toc-label">本文目錄</div>
								<ul>
									{toc.map((h) => (
										<li>
											<a href={`#${h.slug}`} class={`depth-${h.depth}`} data-toc-link={h.slug}>
												{h.text}
											</a>
										</li>
									))}
								</ul>
							</nav>
						)}

						<section class="taxonomy" aria-label="文章分類與議題標籤">
							<div class="taxonomy-section">
								<p class="taxonomy-label">CATEGORY</p>
								<a class="taxonomy-link expand-animation scale-animation" href="/blog/">節目文章</a>
							</div>
							{topicLinks.length > 0 && (
								<div class="taxonomy-section">
									<p class="taxonomy-label">TAGS</p>
									<div class="taxonomy-tags">
										{topicLinks.map((topic) => (
											<a class="taxonomy-tag expand-animation scale-animation" href={`/topics/${topic.slug}/`}><span>{topic.name}</span></a>
										))}
									</div>
								</div>
							)}
							{episode && (
								<div class="taxonomy-section">
									<p class="taxonomy-label">EPISODE</p>
									<a class="taxonomy-link expand-animation scale-animation" href={`/blog/${episode.toLowerCase()}/`}>{episode}</a>
								</div>
							)}
						</section>
					</aside>

					<div class="article prose" data-article-body>
						{episode && aiGenerated && (
							<section class="episode-listen-intro" aria-label="內容來源與收聽連結">
								<p class="source-title">本文內容由 AI 整理自《新世紀直男戰士》{displayEpisodeTitle ?? episode}</p>
								<p class="accuracy-note">整理與維護：新世紀直男戰士製作團隊。<a href="/about/#這裡的文章怎麼來">文章來源與更正方式</a></p>
								<p class="accuracy-note">AI 整理可能有些許誤差，詳細內容歡迎收聽本集節目：</p>
								{hasListenLinks ? (
									<div class="listen-links">
										{effectiveListenLinks.soundon && <a href={effectiveListenLinks.soundon} target="_blank" rel="noopener noreferrer" class="btn-soundon scale-animation">SoundOn</a>}
										{effectiveListenLinks.spotify && <a href={effectiveListenLinks.spotify} target="_blank" rel="noopener noreferrer" class="btn-spotify scale-animation">Spotify</a>}
										{effectiveListenLinks.apple && <a href={effectiveListenLinks.apple} target="_blank" rel="noopener noreferrer" class="btn-apple scale-animation">Apple Podcasts</a>}
										{effectiveListenLinks.kkbox && <a href={effectiveListenLinks.kkbox} target="_blank" rel="noopener noreferrer" class="btn-kkbox scale-animation">KKBOX</a>}
									</div>
								) : (
									<p class="no-links-notice">收聽連結將於整理完成後加入。</p>
								)}
							</section>
						)}
						{episode && aiGenerated && <hr class="episode-intro-divider" />}
						<slot />

						{displayEpisodeTitle && (
							<div class="closing-listen">
								{videoUrl && <p>本集也有影片版，歡迎到 <a href={videoUrl} target="_blank" rel="noopener noreferrer">YouTube 觀看完整對談</a>。</p>}
								<p>更多詳細內容，歡迎收聽《新世紀直男戰士》{displayEpisodeTitle}</p>
								{hasListenLinks && (
									<p class="closing-links">
										{effectiveListenLinks.soundon && <a href={effectiveListenLinks.soundon} target="_blank" rel="noopener noreferrer">SoundOn</a>}
										{effectiveListenLinks.soundon && (effectiveListenLinks.spotify || effectiveListenLinks.apple || effectiveListenLinks.kkbox) && ' ・ '}
										{effectiveListenLinks.spotify && <a href={effectiveListenLinks.spotify} target="_blank" rel="noopener noreferrer">Spotify</a>}
										{effectiveListenLinks.spotify && (effectiveListenLinks.apple || effectiveListenLinks.kkbox) && ' ・ '}
										{effectiveListenLinks.apple && <a href={effectiveListenLinks.apple} target="_blank" rel="noopener noreferrer">Apple Podcasts</a>}
										{effectiveListenLinks.apple && effectiveListenLinks.kkbox && ' ・ '}
										{effectiveListenLinks.kkbox && <a href={effectiveListenLinks.kkbox} target="_blank" rel="noopener noreferrer">KKBOX</a>}
									</p>
								)}
							</div>
						)}

						{relatedPosts.length > 0 && (
							<section class="related" aria-labelledby="related-heading">
								<h2 id="related-heading">你可能也會想讀</h2>
								<ul>
									{relatedPosts.map((related) => (
										<li>
											<a href={`/blog/${related.id}/`}>
												{related.data.title}
												<span class="related-meta">
													{related.data.episode ? `${related.data.episode} · ` : ''}
													<FormattedDate date={related.data.pubDate} />
												</span>
											</a>
										</li>
									))}
								</ul>
							</section>
						)}
					</div>
				</div>
			</article>
		</main>
		<Footer />

	</body>
</html>
